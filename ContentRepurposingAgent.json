      "id": "e53d55e2-6b10-4956-b272-4c13e64d5140",
      "name": "Prepare Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        560,
        160
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Repurpose the following source content into platform-ready drafts.\n\nTitle: {{ $json.title }}\nContent Type: {{ $json.contentType }}\nSource URL: {{ $json.sourceUrl }}\nTarget Audience: {{ $json.audience }}\nVoice & Tone: {{ $json.voiceTone }}\nCall to Action: {{ $json.cta }}\nPrimary Keyword/Hashtag: {{ $json.keyword }}\n\n--- SOURCE CONTENT START ---\n{{ $json.sourceContent }}\n--- SOURCE CONTENT END ---",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a senior content strategist who turns one long-form asset (YouTube video, blog post, or podcast) into distribution-ready drafts across LinkedIn, X, newsletter, YouTube Shorts, and Instagram. You never summarize blandly. You extract the sharpest insight, the most concrete example, and the most quotable line, then rewrite them per-platform using native conventions. Platform rules you MUST follow: (1) linkedin_post: 150-250 words, hook line under 12 words, short paragraphs (1-2 sentences), end with an engagement question or CTA, 3 relevant hashtags at the end. (2) x_thread: 5-8 tweets, each under 280 chars, tweet 1 is a hook that earns the click, numbered \"1/ 2/ ...\" prefix, last tweet is a CTA. (3) newsletter_section: 150-300 words, markdown formatted with one H2, skimmable, ends with a one-line takeaway. (4) youtube_short_script: 45-60 seconds, structured as [Hook 0-3s] [Body 3-45s] [CTA 45-60s], written as spoken dialogue with visual direction in brackets. (5) instagram_caption: 125-220 words, hook in line 1, line breaks every 1-2 sentences, three dot separators before hashtags, 8-15 niche hashtags. (6) title_variants: exactly 5 alternative titles for the source asset optimized for CTR (curiosity, specificity, benefit, contrarian, how-to angles). (7) content_summary: one sentence describing the source. Always match the provided Voice & Tone, weave the Primary Keyword in naturally where relevant, and end each long-form asset with the Call to Action when one is provided. Return ONLY valid JSON that matches the required schema. No preamble, no markdown fences, no commentary.",
          "maxIterations": 3
        }
      },
      "id": "b8d7c017-cc46-4de9-b04f-4c711e472516",
      "name": "Repurpose Content",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        736,
        288
      ]
    },
