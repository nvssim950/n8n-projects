    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"linkedin_post\": \"Hook line under 12 words.\\n\\nShort paragraph 1.\\n\\nShort paragraph 2.\\n\\nEngagement question or CTA.\\n\\n#tag1 #tag2 #tag3\",\n  \"x_thread\": [\n    \"1/ Hook tweet under 280 chars\",\n    \"2/ Story or proof\",\n    \"3/ Insight\",\n    \"4/ Tactical step\",\n    \"5/ Recap + CTA\"\n  ],\n  \"newsletter_section\": \"## Subheading\\n\\nOpening paragraph with value.\\n\\nSecond paragraph with a concrete example.\\n\\nTakeaway line.\",\n  \"youtube_short_script\": \"[Hook 0-3s] Spoken hook line.\\n[Body 3-45s] Spoken body with [visual cues in brackets].\\n[CTA 45-60s] Spoken CTA.\",\n  \"instagram_caption\": \"Hook line.\\n\\nBody lines with line breaks every 1-2 sentences.\\n\\n.\\n.\\n.\\n#hashtag1 #hashtag2 #hashtag3\",\n  \"title_variants\": [\n    \"Curiosity-driven title\",\n    \"Benefit-driven title\",\n    \"Specific-number title\",\n    \"Contrarian title\",\n    \"How-to title\"\n  ],\n  \"content_summary\": \"One-sentence summary of the source content.\"\n}"
      },
