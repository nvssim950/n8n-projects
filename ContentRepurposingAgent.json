    {
      "parameters": {
        "formTitle": "Content Repurposing Studio",
        "formDescription": "Turn one long-form asset into five platform-ready drafts. Paste your transcript or blog body below and we will generate LinkedIn, X, newsletter, YouTube Short and Instagram drafts for you.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Title",
              "placeholder": "e.g. How I built a $10k MRR SaaS in 90 days",
              "requiredField": true
            },
            {
              "fieldLabel": "Source Content",
              "fieldType": "textarea",
              "placeholder": "Paste your transcript, blog body, or detailed podcast notes here.",
              "requiredField": true
            },
            {
              "fieldLabel": "Content Type",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "YouTube Video"
                  },
                  {
                    "option": "Blog Post"
                  },
                  {
                    "option": "Podcast Episode"
                  },
                  {
                    "option": "Other"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Source URL",
              "placeholder": "https://youtube.com/watch?v=...  (optional)"
            },
            {
              "fieldLabel": "Target Audience",
              "placeholder": "e.g. early-stage B2B SaaS founders",
              "requiredField": true
            },
            {
              "fieldLabel": "Voice and Tone",
              "fieldType": "textarea",
              "placeholder": "e.g. Direct, no fluff, contrarian. Avoid corporate jargon."
            },
            {
              "fieldLabel": "Call to Action",
              "placeholder": "e.g. Book a free strategy call"
            },
            {
              "fieldLabel": "Primary Keyword or Hashtag",
              "placeholder": "e.g. automation, #AIagents"
            }
          ]
        },
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Generate Drafts"
        }
      },
