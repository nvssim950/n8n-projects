      "id": "5b619deb-ab50-4717-bc36-84b4141882cd",
      "name": "Apollo Person Match",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        432,
        304
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// If Apollo returned a real person, pass it through. Otherwise synthesize from the form input.\nconst apollo = ($input.first() && $input.first().json) || {};\nif (apollo.person && apollo.person.id) {\n  return [{ json: apollo }];\n}\nconst form = ($('Inbound Form').first().json.body) || {};\nconst email = form.email || 'lead@example.com';\nconst domain = email.split('@')[1] || 'example.com';\nconst firstName = form.firstName || 'Sample';\nconst lastName = form.lastName || 'Lead';\nconst title = form.jobTitle || 'Head of Operations';\nconst companyName = form.company || domain.split('.')[0].replace(/^./, function(c){ return c.toUpperCase(); });\nconst senior = /vp|head|director|chief|cmo|ceo|founder/i.test(title);\nreturn [{\n  json: {\n    person: {\n      id: 'apollo_' + Date.now(),\n      first_name: firstName,\n      last_name: lastName,\n      name: firstName + ' ' + lastName,\n      title: title,\n      seniority: senior ? 'vp' : 'manager',\n      email: email,\n      linkedin_url: 'https://linkedin.com/in/' + firstName.toLowerCase() + '-' + lastName.toLowerCase(),\n      organization: {\n        id: 'apollo_org_' + domain,\n        name: companyName,\n        primary_domain: domain,\n        estimated_num_employees: 220,\n        industry: 'logistics and supply chain',\n        keywords: ['logistics','supply chain','freight','carrier onboarding','3pl'],\n        technologies: ['Salesforce','HubSpot','Snowflake','Segment']\n      }\n    }\n  }\n}];"
      },
