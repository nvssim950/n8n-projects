    {
      "parameters": {
        "jsCode": "// If Clearbit returned a domain/name, pass through. Otherwise synthesize from the form input.\nconst clearbit = ($input.first() && $input.first().json) || {};\nif (clearbit.domain && clearbit.name) {\n  return [{ json: clearbit }];\n}\nconst form = ($('Inbound Form').first().json.body) || {};\nconst email = form.email || 'lead@example.com';\nconst domain = email.split('@')[1] || 'example.com';\nreturn [{\n  json: {\n    domain: domain,\n    name: (form.company || domain.split('.')[0]).toString(),\n    category: {\n      industry: 'Logistics & Supply Chain',\n      industryGroup: 'Transportation',\n      sector: 'Industrials',\n      subIndustry: '3PL'\n    },\n    metrics: {\n      employees: 220,\n      employeesRange: '100-500',\n      estimatedAnnualRevenue: '$10M-$50M'\n    },\n    tech: ['salesforce','hubspot','snowflake','segment','aws'],\n    tags: ['B2B','Logistics','SaaS']\n  }\n}];"
      },
      "id": "8a4cc2d0-27d2-4d80-aa73-40402b5055d2",
      "name": "Company Enrichment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1088,
