            },
            {
              "id": "c6",
              "name": "websiteSnippet",
              "value": "={{ String($json.data ?? \"\").replace(/<script[\\s\\S]*?<\\/script>/gi, \" \").replace(/<style[\\s\\S]*?<\\/style>/gi, \" \").replace(/<[^>]+>/g, \" \").replace(/\\s+/g, \" \").trim().substring(0, 6000) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "ab449ec6-fe1b-45ec-8a36-57b120a0a351",
      "name": "Compose AI Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        912,
        400
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this lead and produce qualification + personalized cold email.\n\nLEAD\nName: {{ $json.leadName }}\nEmail: {{ $json.leadEmail }}\nCompany: {{ $json.leadCompany }}\nWebsite: {{ $json.leadWebsite }}\nNotes from sales: {{ $json.leadNotes }}\n\nCOMPANY WEBSITE CONTENT (plain text snippet, may be truncated)\n{{ $json.websiteSnippet }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a B2B sales development AI for an Automation & AI Agent consultancy.\n\nICP (Ideal Customer Profile):\n- SaaS, e-commerce, or professional services companies\n- 10 to 500 employees\n- Repetitive manual work in sales ops, support, marketing, recruiting, or back-office\n- Growth signals: hiring, recent funding, busy careers page, expanding team\n\nYour job:\n1. Infer the industry and what the company does from their website content.\n2. Write a one-line companySummary.\n3. Extract 2-3 specific painPoints that AI agents or automation could solve.\n4. Score ICP fit from 1 to 10 (10 = perfect fit, 7+ = reach out, below 7 = skip).\n5. Write a short personalized cold email (under 140 words) that:\n   - opens with a specific, factual observation about THEIR company (from the website)\n   - names ONE concrete pain automation could fix\n   - includes a soft CTA (15-min call)\n   - signs off as \"[Your Name]\"\n\nRules:\n- Never invent facts not present in the website content or notes.\n- If website content is empty or unrelated, say so in reasoning and score conservatively (fitScore <= 5).\n- Email must feel human. No corporate jargon. No \"I hope this finds you well\".\n- Return ONLY the JSON object matching the schema. No prose, no markdown fences.",
          "maxIterations": 3
        }
      },
      "id": "69409005-fc21-4bc3-a36b-73347929399c",
      "name": "Qualify & Draft Email",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1120,
        400
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini",
          "cachedResultName": "gpt-5-mini"
        },
        "builtInTools": {},
        "options": {
          "temperature": 0.2
        }
      },
      "id": "efdc17c5-73b9-42c4-8e02-9d3d53c80eb0",
      "name": "OpenAI gpt-5-mini",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        1072,
        624
      ],
      "credentials": {
        "openAiApi": {
          "id": "MhAPi6hmlbiCjxgb",
          "name": "n8n free OpenAI API credits"
        }
      }
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"fitScore\": 8,\n  \"reasoning\": \"Acme HR is an HR SaaS scaling hiring based on careers page and recent funding — matches ICP.\",\n  \"industry\": \"HR SaaS\",\n  \"companySummary\": \"HR software helping startups hire engineers faster.\",\n  \"painPoints\": [\n    \"Manual resume screening\",\n    \"Slow candidate outreach\"\n  ],\n  \"emailSubject\": \"Quick idea for Acme's hiring ramp\",\n  \"emailBody\": \"Hi Sarah,\\n\\nNoticed Acme's careers page went from 4 to 22 open roles this quarter — that usually means recruiting ops is drowning.\\n\\nWe build AI agents that auto-screen resumes and draft personalized candidate outreach, cutting screening time by ~70%. Worth a 15-min chat next week?\\n\\nBest,\\n[Your Name]\"\n}"
      },
      "id": "d5f57b5e-912f-4aa5-b113-446e8b659db8",
      "name": "Lead Analysis Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1264,
        624
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: \"processed\", qualified: $json.output.fitScore >= 7, lead: { email: $(\"Normalize Lead\").item.json.email, firstName: $(\"Normalize Lead\").item.json.firstName, company: $(\"Normalize Lead\").item.json.company }, analysis: $json.output, receivedAt: $(\"Normalize Lead\").item.json.receivedAt } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "e12e218c-ce21-4a26-b2a5-dbe1366733bf",
      "name": "Respond With Analysis",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1392,
        400
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "fit-check",
              "leftValue": "={{ $(\"Qualify & Draft Email\").item.json.output.fitScore }}",
              "rightValue": 7,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "1e60ac0b-b197-441c-a4f3-73c619724069",
      "name": "Is Qualified (score >= 7)",
