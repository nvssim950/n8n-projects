        "text": "=:fire: *New qualified lead* — score *{{ $(\"Qualify & Draft Email\").item.json.output.fitScore }}/10*\n*{{ $(\"Normalize Lead\").item.json.firstName }} {{ $(\"Normalize Lead\").item.json.lastName }}* at *{{ $(\"Normalize Lead\").item.json.company }}*\n:email: {{ $(\"Normalize Lead\").item.json.email }}\n:globe_with_meridians: {{ $(\"Normalize Lead\").item.json.website }}\n:bulb: _Industry:_ {{ $(\"Qualify & Draft Email\").item.json.output.industry }}\n:dart: _Why a fit:_ {{ $(\"Qualify & Draft Email\").item.json.output.reasoning }}\n:white_check_mark: Personalized email sent.",
        "otherOptions": {
