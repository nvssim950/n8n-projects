      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "leadName",
              "value": "={{ $(\"Normalize Lead\").item.json.firstName }} {{ $(\"Normalize Lead\").item.json.lastName }}",
              "type": "string"
            },
            {
              "id": "c2",
              "name": "leadEmail",
              "value": "={{ $(\"Normalize Lead\").item.json.email }}",
              "type": "string"
            },
            {
