              "responseFormat": "text"
            }
          },
          "timeout": 15000
        }
      },
      "id": "cc04d0e6-d55c-4400-bd47-5a3773bdb8c1",
      "name": "Fetch Company Website",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        688,
