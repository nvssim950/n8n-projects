              "value": "={{ $(\"Normalize Lead\").item.json.company }}",
              "type": "string"
            },
            {
              "id": "c4",
              "name": "leadWebsite",
              "value": "={{ $(\"Normalize Lead\").item.json.website }}",
              "type": "string"
            },
            {
